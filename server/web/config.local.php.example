 * ============================================================
 *  Trên VPS:  cp web/config.local.php.example web/config.local.php
 *             rồi sửa config.local.php (KHÔNG sửa config.php trực tiếp -
 *             sửa config.php trên VPS sẽ làm git status "dirty" và chặn
 *             deploy-auto.sh lần deploy kế tiếp).
 * ============================================================
 */

/**
 * ---- Kết nối database: THƯỜNG KHÔNG CẦN KHAI Ở ĐÂY ----
 *
 * config.php tự đọc thẳng từ file cấu hình của chính game server:
 *
 *     /opt/kpah/server.ini              db.host, db.name, db.user, db.password
 *     /opt/kpah/loginServer/server.ini  db.url, db.user, db.password
 *
 * Nhờ vậy web và server luôn dùng chung một thông tin - đổi mật khẩu database
 * ở server.ini là web theo ngay, không phải nhớ sửa hai chỗ.
 *
 * CHỈ khai bốn dòng dưới khi:
 *   - website KHÔNG nằm cùng máy / cùng cây thư mục với game server, HOẶC
 *   - PHP không có quyền đọc server.ini (nó thường là chmod 640 chown kpah:kpah,
 *     mà PHP chạy dưới www-data). Cách khác là cấp quyền đọc:
 *         usermod -a -G kpah www-data && systemctl restart php8.2-fpm
 *
 * Trang Chẩn đoán (web/admin/chandoan.php) có mục "Nguồn thông tin database"
 * cho biết đang đọc được từ server.ini hay đang dùng giá trị khai tay.
 *
 * Khai tay thì nó THẮNG server.ini.
 */
// define('DB_HOST', '127.0.0.1');
// define('DB_PORT', 3306);
// define('DB_USER', 'kpah');
// define('DB_PASS', '');                 // mật khẩu MySQL thật

/**
 * Thư mục gốc của game server (nơi có server.ini, errorlog.txt, log/game.out).
 * Mặc định là thư mục cha của web/ - đúng sẵn cho VPS vì server chạy với
 * WorkingDirectory=/opt/kpah còn web ở /opt/kpah/web. Chỉ đặt lại khi chép
 * riêng thư mục web/ đi chỗ khác, ví dụ sang C:\xampp\htdocs để chạy thử.
 */
