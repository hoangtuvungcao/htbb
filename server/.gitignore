/KPAH2_NEW.jar
/KPAH2_patched_backup_truoc_capnhat.jar
# Jar TRUOC commit 2480c47, trich tu git (b87782e) de thu phan doi loi nhay 05/09/2026.
# Da co san trong lich su git, khong can commit lai.
/KPAH2_TRUOC_2480c47_de_thu.jar

