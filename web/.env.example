# Ten cu KPAH_* van duoc doc neu chua co HTBB_* (giu 1 ban phat hanh). TUONG-THICH-TEN-CU
# =====================================================================
#  CẤU HÌNH WEBSITE HTBB — chép thành .env (dev) hoặc /etc/htbb/htbb.env
#  (VPS: root:root 0600, nạp bằng EnvironmentFile của htbb-web + htbb-game) rồi điền giá trị THẬT.
#  KHÔNG commit file chứa giá trị thật.
# =====================================================================

# Thư mục CHỨA server.ini của game server (cũng có loginServer/server.ini, errorlog.txt,
# bao_tri.txt). VPS: /opt/htbb/server. Mặc định: <thư mục chạy web>/../server (monorepo).
HTBB_SERVER_DIR=/opt/htbb/server

# Khoá ký token đăng nhập. BẮT BUỘC đặt một chuỗi ngẫu nhiên dài trên VPS:
#   openssl rand -hex 32
# Đổi khoá = mọi người (kể cả admin) bị đăng xuất.
HTBB_SECRET=

# ---- Database: THƯỜNG KHÔNG CẦN KHAI ----
# Web tự đọc server.ini + loginServer/server.ini trong HTBB_SERVER_DIR.
# Khai ở đây thì THẮNG server.ini (dùng khi web ở máy khác / không đọc được ini).
# HTBB_DB_HOST=127.0.0.1
# HTBB_DB_PORT=3306
# HTBB_DB_USER=htbb
# HTBB_DB_PASS=
# HTBB_DB_GAME=htbb_db
# HTBB_DB_ACCOUNT=account
# HTBB_DB_ACCOUNT_USER=     # chỉ khi login server dùng user DB khác
# HTBB_DB_ACCOUNT_PASS=

# ---- Proxy ----
# Node chạy sau nginx cùng máy: chỉ tin X-Forwarded-For khi kết nối đến
# từ các địa chỉ này. Mặc định: 127.0.0.1,::1,::ffff:127.0.0.1
# HTBB_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# ---- Địa chỉ website (canonical, sitemap.xml, robots.txt, og:url/og:image) ----
# NGUỒN DUY NHẤT cho địa chỉ gốc — mã nguồn không ghi cứng tên miền nào, cũng không lấy theo Host
# của request. Để trống = http://localhost:3000.
# CHƯA CÓ TÊN MIỀN (trống, localhost, 127.x, địa chỉ IP, .local/.test): website tự CHẶN lập chỉ mục —
# robots.txt "Disallow: /", mọi trang có <meta name="robots" content="noindex, nofollow"> và
# header X-Robots-Tag. Có tên miền thật thì đặt, vd. HTBB_SITE_URL=https://ten-mien-cua-ban.vn
# (chỉ lấy phần gốc, đường dẫn phía sau bị bỏ), rồi khởi động lại web.
# HTBB_SITE_URL=

# ---- Danh sách máy chủ cho client game (GET /server.txt) ----
# Client Unity tải http://<host>/server.txt lúc mở game. Mỗi máy chủ "Tên:host:cổng:loại"; nhiều máy
# chủ ngăn bằng hai ký tự \n (một dòng duy nhất). Trống = /server.txt trả 503.
# Trước đây là tệp tĩnh HTBB/web/server.txt của website PHP cũ (đã bỏ).
# HTBB_SERVER_LIST=Server 1:203.0.113.10:19129:0
# Client cũ đã phát hành tải link danh sách cũ (server/utils/duongDanCu.ts) — mặc định cùng nội dung trên;
# muốn khác thì đặt riêng. Link cũ /kpah/... và /*.php tự 301 sang trang Nuxt.
# HTBB_SERVER_LIST_CU=

# ---- Trang công khai ----
HTBB_LINK_ANDROID=#
HTBB_LINK_PC=#
HTBB_LINK_IOS=#
HTBB_LINK_JAR=#
# Kênh hỗ trợ là Zalo, đặt ở /admin/cai-dat -> "Hỗ trợ qua Zalo" (link + ảnh QR). Biến này chỉ là
# dự phòng khi CMS chưa đặt, và CHỈ nhận link https://zalo.me/..., https://chat.zalo.me/...,
# https://oa.zalo.me/... (link khác hoặc # = coi như chưa có, nút hỗ trợ bị ẩn).
HTBB_LINK_GROUP=#
# true = đăng ký xong vào game được luôn (chỉ có tác dụng khi sv.EnableAvtiveCheck=1)
HTBB_AUTO_ACTIVATE=false

# ---- Nạp tiền (docs/van-hanh.md — mục SePay: hướng dẫn từng bước) ----
# Bật/tắt TOÀN BỘ nạp tiền. Mặc định false. CHỈ bật khi đã có giấy phép hình ảnh/IP (asset PMDCollab
# CC BY-NC 4.0, tên Pokémon của Nintendo). false = ẩn menu/trang Nạp, /api/nap/** + /api/xac-nhan-nap/** trả 403.
# Server game phải bật cùng: sv.lau_dai=1 + sv.nap_tien=1 (server.ini).
# FAIL CLOSED trên máy thật: đặt true mà một mục dưới đây trống/yếu/mặc định thì web TỰ TẮT nạp và in
# "NAP TIEN BI TAT (fail closed)" kèm lý do (HTBB_SECRET >= 32 ký tự, mật khẩu /xac-nhan-nap >= 12 ký tự
# và không phải mặc định, số TK + tên chủ TK + BIN thật, HTBB_SEPAY_WEBHOOK_APIKEY >= 24 ký tự, không sandbox).
HTBB_NAP_BAT=false
# Đặt 1 SAU KHI có giấy phép bằng văn bản. Thiếu = trang /admin/naptien hiện cảnh báo đỏ.
NAP_DA_CO_GIAY_PHEP=
# Tài khoản nhận tiền (phải trùng tài khoản đã liên kết trên SePay). Tên viết HOA KHÔNG DẤU như trên app ngân hàng.
# (Tên cũ HTBB_TPBANK_ACCOUNT_NO / _NAME vẫn đọc được.)
HTBB_NAP_ACCOUNT_NO=
HTBB_NAP_ACCOUNT_NAME=
# Mã BIN ngân hàng theo chuẩn VietQR/NAPAS (dùng dựng mã QR + mở app). Kiểm lại ở https://api.vietqr.io/v2/banks
#   970436 Vietcombank   970415 VietinBank    970418 BIDV        970405 Agribank
#   970407 Techcombank   970422 MB Bank       970416 ACB         970432 VPBank
#   970423 TPBank        970403 Sacombank     970441 VIB         970437 HDBank
#   970443 SHB           970448 OCB           970426 MSB         970440 SeABank
#   970431 Eximbank      970449 LPBank
HTBB_NAP_BANK_BIN=970423
# SePay > Webhooks > Kiểu chứng thực "API Key": dán CÙNG một chuỗi ngẫu nhiên >= 24 ký tự (openssl rand -hex 24)
# vào đây và vào SePay. URL webhook: https://<tên-miền>/api/nap/webhook-sepay
HTBB_SEPAY_WEBHOOK_APIKEY=
# (Tuỳ chọn) SePay > Cấu hình công ty > API Access: token để job dò giao dịch LỠ webhook mỗi 2–5 phút.
# Trống = tắt job. HTBB_SEPAY_DO_PHUT (2–5, mặc định 3), HTBB_SEPAY_DO_GIO (giờ nhìn lại, mặc định 6).
HTBB_SEPAY_API_TOKEN=
HTBB_SEPAY_DO_PHUT=3
HTBB_SEPAY_DO_GIO=6
# (Tuỳ chọn) Casso webhook v2 (HMAC). Đối chiếu tài liệu Casso trước khi dùng.
HTBB_CASSO_WEBHOOK_SECRET=
# Mật khẩu trang xác nhận nạp thủ công (/xac-nhan-nap). Mặc định = trang bị khoá (404) và CHẶN bật nạp trên máy thật.
HTBB_ADMIN_NAPTIEN_PASSWORD=doi-mat-khau-nay
# CHỈ MÁY DEV: 1 = mở /api/nap/webhook-mock + nút "Giả lập" trong admin. Bật trên máy thật = nạp bị tắt.
HTBB_NAP_SANDBOX=0
# Khoá ký webhook mock (HMAC-SHA256) — chỉ dùng khi HTBB_NAP_SANDBOX=1.
HTBB_NAP_MOCK_SECRET=

# ---- BẢN DEMO nạp tiền + Thành viên (docs/van-hanh.md mục 9.6) ----
# 1 = cho XEM luồng nạp / mua Thành viên trên máy thật mà KHÔNG thu được tiền:
#   - banner "BẢN DEMO — không chuyển tiền. Số tài khoản chỉ để minh hoạ." trên mọi trang nạp / Thành viên;
#   - hình QR GIẢ (không quét được) + chữ DEMO, không có nút mở app ngân hàng;
#   - đơn demo chỉ nằm trong bộ nhớ web (mã DM...), không vào nap_*, không cộng lượng / Thành viên;
#   - webhook SePay/Casso/mock và /xac-nhan-nap trả 403 + ghi log; nút "Giả lập thanh toán" ở /admin/naptien
#     chỉ đổi màn hình sang thành công.
# HTBB_NAP_ACCOUNT_NO phải là số MINH HOẠ có chữ x (VD 0123456xxx); số tài khoản thật = demo bị từ chối.
# LOẠI TRỪ với nạp thật: cấu hình thật đã hợp lệ (hoặc HTBB_NAP_BAT đang chạy thật) thì demo bị TỪ CHỐI, giữ chế độ thật.
# CẢNH BÁO: KHÔNG dùng demo thay cho nạp thật, và tắt demo (HTBB_NAP_DEMO=0) TRƯỚC khi điền cấu hình thật.
HTBB_NAP_DEMO=0
# 1 (mặc định) = chỉ tài khoản người chơi có tên trong HTBB_ADMIN_ACCOUNTS (đã đăng nhập website) thấy menu
# và trang Nạp / Thành viên bản demo; người khác thấy "đang tắt" như bình thường. 0 = mọi người thấy bản demo.
HTBB_NAP_DEMO_CHI_ADMIN=1

# ---- Trang quản trị (/admin) ----
# Tên TÀI KHOẢN ĐĂNG NHẬP (team_user.username), ngăn bằng dấu phẩy.
# Để trống = KHÔNG AI vào được.
HTBB_ADMIN_ACCOUNTS=
# true = tài khoản chưa ghi danh hai bước (TOTP) thì không vào được admin.
HTBB_ADMIN_2FA_BAT_BUOC=false
# Chỉ cho các IP / dải CIDR này gọi API quản trị (cách dấu phẩy). Bỏ trống = không giới hạn.
# HTBB_ADMIN_IP_CHO_PHEP=203.0.113.5, 10.0.0.0/8, ::1
# HTBB_ADMIN_IDLE_TIMEOUT=3600
# HTBB_ADMIN_MAX_FAIL=8
# HTBB_ADMIN_FAIL_WINDOW=900

# ---- Gửi email qua Gmail API (Quên mật khẩu, thư báo đổi mật khẩu/email) ----
# Thiếu một trong 4 giá trị đầu = tắt chức năng Quên mật khẩu (trang báo "chưa bật").
# Cách lấy: README mục "Gửi email (Gmail API)" + node scripts/lay-gmail-refresh-token.mjs
# HTBB_GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# HTBB_GMAIL_CLIENT_SECRET=
# HTBB_GMAIL_REFRESH_TOKEN=
# HTBB_GMAIL_SENDER=tenban@gmail.com
# HTBB_MAIL_FROM_NAME=HTBB Pokémon

# Thư mục lưu ảnh tải lên từ khu quản trị (CMS). Mặc định: <thư mục chạy web>/uploads
# HTBB_UPLOAD_DIR=/opt/htbb/web/uploads
# Bản tải game (admin tải lên, nginx phát ở /downloads/) + giới hạn cỡ tệp (MB)
# HTBB_TAI_GAME_DIR=/opt/htbb/downloads
# HTBB_TAI_GAME_TOI_DA_MB=320
# Thư mục log game.out / login.out / *.log (trang /admin/chandoan). Mặc định: <HTBB_SERVER_DIR>/../logs
# HTBB_LOG_DIR=/opt/htbb/logs
# Đồng bộ dữ liệu game từ /admin/dong-bo: đường dẫn mã nguồn website + gốc monorepo
# HTBB_WEB_SRC_DIR=/opt/htbb/web
# HTBB_DIR=/opt/htbb
