# /etc/systemd/system/kpah-web.service
# Website HTBB (Nuxt). Bien moi truong do GitHub Actions ghi vao /etc/kpah-web.env
# (xem deploy/deploy-web.sh). Apache dung truoc, chuyen tiep ve 127.0.0.1:3000.
[Unit]
Description=Website HTBB (Nuxt)
After=network.target novadb.service

[Service]
Type=simple
User=kpah-web
# Nhom kpah: de doc duoc /opt/kpah/server.ini (chmod 640 kpah:kpah) va file log cua game.
Group=kpah-web
SupplementaryGroups=kpah
EnvironmentFile=/etc/kpah-web.env
WorkingDirectory=/opt/kpah-web/current
ExecStart=/usr/bin/node /opt/kpah-web/current/.output/server/index.mjs
Restart=always
RestartSec=3

# Cung hoa: web chi can doc /opt/kpah, khong can ghi o dau tren dia.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/kpah

[Install]
WantedBy=multi-user.target
