# /etc/systemd/system/htbb-web.service - website HTBB (Nuxt 4 / Nitro tren 127.0.0.1:3000).
# nginx (vps/htbb-nginx.conf) dung truoc, chuyen tiep ve 127.0.0.1:3000.
# Ban build: /opt/htbb/web/.output (symlink -> releases/<sha>/.output, xem deploy/deploy-web.sh).
# Bien moi truong: /etc/htbb/htbb.env (root:root 0600, dung chung voi htbb-game) - CSDL MariaDB
# 127.0.0.1:3306, HTBB_SECRET, HTBB_SERVER_DIR=/opt/htbb/server...
[Unit]
Description=HTBB website (Nuxt 4 / Nitro on 127.0.0.1:3000)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=htbb
Group=htbb
EnvironmentFile=/etc/htbb/htbb.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NITRO_HOST=127.0.0.1
Environment=NITRO_PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=384
WorkingDirectory=/opt/htbb/web
ExecStart=/usr/bin/node /opt/htbb/web/.output/server/index.mjs
Restart=always
RestartSec=3
MemoryMax=640M
UMask=0027

# Cung hoa. Web doc server.ini / log, ghi anh CMS + ban tai game, va tep co bao tri (bao_tri.txt)
# trong thu muc server.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/htbb/web/uploads /opt/htbb/downloads /opt/htbb/server
ReadOnlyPaths=/opt/htbb/logs

[Install]
WantedBy=multi-user.target
