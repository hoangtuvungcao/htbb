# .gitignore gốc của monorepo htbb. web/.gitignore và .gitignore trong từng client vẫn có hiệu lực.

# ---- VPS: /opt/htbb là bản checkout repo này; log, sao lưu, bản tải nằm ở gốc ----
/log
/logs/
/backup/
/backups/
/downloads/

# ---- máy dev / IDE / hệ điều hành ----
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath
.apt_generated/
.sts4-cache/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# ---- khoá ký và bí mật (không bao giờ commit) ----
*.jks
*.keystore
key.properties
.env
.env.*
!.env.example

# ---- server: tệp chạy (cấu hình thật, log, trạng thái) và bản build ----
/server/build/
/server/dist/
/server/out/
/server/chay_novadb/
/server/**/server.ini
/server/**/server.ini.bak
/server/**/server.ini.tmp
/server/*.txt
/server/*.txt.[0-9]*
/server/*.out
/server/*.sql
/server/*.sql.gz
/server/trang_thai.json
/server/trang_thai.json.tmp
/server/bao_tri.txt
/server/*_backup*.jar
/server/*_NEW.jar
/server/*_TRUOC_*.jar
/server/web/

# ---- client: bản build ----
/client_jar/out/
/client_jar/.truoc_map_moi/
/client_jar/**/mapping-*.txt
/client_apk/**/mapping-*.txt
/client_pc/out/

# ---- dữ liệu / công cụ: tệp tải về và kết quả tạm (sinh lại được) ----
/du_lieu/map_giai/
/du_lieu/map_moi/kiem/
/du_lieu/mo_phong_*.png
/du_lieu/xem_truoc_*.png
/tools/pokemon/pmd_raw/
/tools/pokemon/pmd_raw_icon/
/tools/pokemon/pmd_raw_tile_moi/
/tools/phat-hanh/may_chu.conf
/tools/phat-hanh/tam/

# ---- dữ liệu loài tải về (PokeAPI / Showdown / PMDCollab, ghim commit): chỉ commit LICENSE + nguon.txt ----
/tools/pokemon/nguon_loai/*/*
!/tools/pokemon/nguon_loai/*/LICENSE
!/tools/pokemon/nguon_loai/*/LICENSE.md

# ---- nhánh p2p: Peerova (build ra p2p/out, kết quả build cũ trong bản chép peerova) ----
/p2p/out/
/p2p/peerova/target/
/p2p/peerova/bindings/java/build/
/p2p/peerova/bindings/csharp/Test/bin/
/p2p/peerova/bindings/csharp/Test/obj/
/p2p/peerova/**/node_modules/
/p2p/peerova/**/.dart_tool/
/p2p/test/unity-net/obj/
/p2p/test/unity-net/bin/
/p2p/peerova/scripts/__pycache__/
