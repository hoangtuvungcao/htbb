### Ban dump DB thuc te - KHONG commit ###
# Chua toan bo du lieu nguoi choi + hash mat khau tai khoan, va rat nang
# (htbb_db.sql ~140 MB). Commit vao la nam vinh vien trong lich su git.
/server/htbb_db.sql
# TUONG-THICH-TEN-CU-DONG-SAU: mau ten cu, bo sau 1 ban
/server/kpah_db.sql
/server/account.sql
/server/*.sql.gz

### Chi co tren VPS Linux (khong dua vao git) ###
/log/
/backup/
/server/.ssh/
/server/**/*.out
/docs/**/*.out
/sql/**/*.out
/tools/**/*.out
/vps/**/*.out
/client_pc_ios/ClientUnity/**/*.out
# AdminChat.txt truoc day duoc theo doi (co dong "!AdminChat.txt" mien tru). Da bo:
# server GHI TIEP vao file nay moi khi admin chat, nen no lam "git status" tren VPS
# dirty va deploy-auto.sh TU CHOI git pull. Ban cu con o /root/htbb-backup tren VPS.
/server/**/AdminChat*.txt
/docs/**/AdminChat*.txt
/sql/**/AdminChat*.txt
/tools/**/AdminChat*.txt
/vps/**/AdminChat*.txt
/client_pc_ios/ClientUnity/**/AdminChat*.txt
# File server tu sinh, dat ten theo IP ket noi (vd 42.119.73.152.txt) - khong phai
# code, lam "git status" tren VPS bi dirty va chan deploy-auto.sh neu khong bo qua.
# IP luon bat dau bang chu so nen loc theo dau ten file, chi ap dung o thu muc goc.
/server/[0-9]*.txt

### Web PHP cu (web/) - DA BO 19/10/2026, website la HTBB-Web (Nuxt, repo rieng) ###
# Ban checkout tren VPS (/opt/htbb) van con sot tep KHONG theo doi cua web cu
# (web/config.local.php chua mat khau DB/ngan hang, .bak, .swp...). Khong bo qua
# thi "git status --porcelain" hien "?? web/" va deploy-auto.sh TU CHOI git pull.
# Xoa tay thu muc do tren VPS khi chac khong can nua (xem vps/CHUYEN_TEN_HTBB.md).
/server/web/
# Chan CHUNG cho moi file tam cua trinh soan thao, o bat ky dau trong repo. Hai dong
# tren chi chan dung mot duong dan, nen ngay 30/08/2026 lai vap tiep: nano mo
# /opt/htbb/server.ini sinh ra /opt/htbb/.server.ini.swp va deploy dung lai.
/server/**/*.swp
/docs/**/*.swp
/sql/**/*.swp
/tools/**/*.swp
/vps/**/*.swp
/client_pc_ios/ClientUnity/**/*.swp
/server/**/*.swo
/docs/**/*.swo
/sql/**/*.swo
/tools/**/*.swo
/vps/**/*.swo
/client_pc_ios/ClientUnity/**/*.swo
/server/**/*~
/docs/**/*~
/sql/**/*~
/tools/**/*~
/vps/**/*~
/client_pc_ios/ClientUnity/**/*~
/server/**/.*.sw?
/docs/**/.*.sw?
/sql/**/.*.sw?
/tools/**/.*.sw?
/vps/**/.*.sw?
/client_pc_ios/ClientUnity/**/.*.sw?

