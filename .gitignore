# Tai nguyen game do tools/ChuyenTaiNguyen.java sinh ra tu ban client J2ME.
# La san pham dan xuat, khong phai ma nguon: tao lai bang mot lenh (xem README).
# Khong commit de repo khoi phinh them vai nghin tep nhi phan.
/client_pc_ios/ClientUnity/Assets/Resources/*
/client_pc_ios/ClientUnity/Assets/Resources.meta
# Ngoai le: sprite Pokemon do tools/pokemon/DongGoiSprite.java sinh tu PMDCollab (CC BY-NC).
# DUOC commit de build client khong can mang/Python (xem docs/pokemon/KE_HOACH_CHUYEN_DOI.md 7.1).
!/client_pc_ios/ClientUnity/Assets/Resources/poke/
# Ngoai le: bo tile ban do moi (CC0) do tools/pokemon/DungBoTileMoi.java sinh, cung ly do nhu poke/.
!/client_pc_ios/ClientUnity/Assets/Resources/poke_tile/
# Ngoai le: kieu tile bo moi + ban do 0 ve lai (tools/pokemon/VeMapMoi.java, docs/pokemon/DINH_DANG_MAP.md).
!/client_pc_ios/ClientUnity/Assets/Resources/poke_map/

