### San pham build trung gian ###
# build.bat tao ra, capnhat.bat tieu thu - deu sinh ra tu htbb-server.jar + src/,
# khong phai ma nguon. Truoc day bi commit nham, lam repo phinh ~4.5 MB jar trung lap.
/server/HTBB_NEW.jar
# Ten cu cua HTBB_NEW.jar: may dev / VPS co the con file nay; con bo qua de
# git status --porcelain (deploy-auto.sh) khong coi la "file bi sua tay".
/server/HTBB_NEW.jar
# TUONG-THICH-TEN-CU-DONG-SAU: mau ten cu, bo sau 1 ban
/server/KPAH2_NEW.jar
/server/htbb-server_backup_truoc_capnhat.jar
# TUONG-THICH-TEN-CU-DONG-SAU: mau ten cu, bo sau 1 ban
/server/KPAH2_patched_backup_truoc_capnhat.jar
# Jar TRUOC commit 2480c47, trich tu git (b87782e) de thu phan doi loi nhay 05/09/2026.
# Da co san trong lich su git, khong can commit lai.
/server/htbb-server_TRUOC_2480c47_de_thu.jar
# TUONG-THICH-TEN-CU-DONG-SAU: mau ten cu, bo sau 1 ban
/server/KPAH2_TRUOC_2480c47_de_thu.jar

