# Release build configuration — baked into every binary by scripts/build-release.sh.
# Values here are defaults; an already-set environment variable wins.
#
# Website: licensing, rendezvous, connect codes.
PEEROVA_LICENSE_SERVER=https://peerova.pages.dev
# Automatic encrypted fallback route (used only when a direct connection fails).
# The website can also announce a different one at runtime (env RELAY_URL on the site),
# so moving it to another server later needs no new build.
PEEROVA_RELAY_URL=https://peerova.pages.dev
# Public keys (files): license authority and release signing.
PEEROVA_AUTHORITY_PUBKEY_FILE=$HOME/.config/peerova/authority.pub
PEEROVA_RELEASE_PUBKEY_FILE=$HOME/.config/peerova/release.pub
