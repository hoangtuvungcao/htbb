[Unit]
Description=HTBB login server (CheckLoginSocket)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=kpah
Group=kpah
WorkingDirectory=/opt/kpah/loginServer
Environment=LANG=en_US.UTF-8
ExecStart=/usr/bin/java -Xms32m -Xmx96m -Dfile.encoding=UTF-8 -jar CheckLoginSocket.jar
Restart=always
RestartSec=5
StandardOutput=append:/opt/kpah/log/login.out
StandardError=append:/opt/kpah/log/login.out

[Install]
WantedBy=multi-user.target
