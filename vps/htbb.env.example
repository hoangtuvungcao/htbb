# =====================================================================
#  BẢN MẪU /etc/htbb/htbb.env — MÁY CHỦ THẬT (VPS)
#
#  Dùng chung cho htbb-web (EnvironmentFile) và htbb-game (EnvironmentFile=-), đồng thời được
#  vps/sinh-server-ini.sh (DB_*) và vps/backup_db.sh (HTBB_DB_*) đọc từng khoá.
#  Cài:  sudo install -o root -g root -m 600 vps/htbb.env.example /etc/htbb/htbb.env
#        rồi THAY mọi giá trị DOI_... bằng giá trị thật, sau đó:
#        sudo systemctl restart htbb-web   (và htbb-game nếu đổi DB_*)
#
#  QUY TẮC:
#   - Chỉ chứa CHỖ TRỐNG / GIÁ TRỊ MẪU — KHÔNG commit file có giá trị thật.
#   - Mỗi dòng KHOA=gia_tri; KHÔNG ghi chú cuối dòng (systemd coi là một phần giá trị).
#   - Giá trị có dấu cách thì bọc trong nháy kép: KHOA="gia tri".
#   - Deploy từ GitHub (web/deploy/deploy-web.sh nhan-env) GHI ĐÈ các khoá GitHub gửi;
#     khoá GitHub không gửi thì giữ nguyên như trong file này.
#   - Giải thích chi tiết từng nhóm: web/.env.example, docs/van-hanh.md, docs/trien-khai.md.
# =====================================================================

# ---- Thư mục ----
# Thư mục CHỨA server.ini của game (cùng loginServer/server.ini, bao_tri.txt).
HTBB_SERVER_DIR=/opt/htbb/server
# Gốc bản checkout monorepo (sinh-server-ini.sh, đồng bộ dữ liệu ở /admin/dong-bo).
HTBB_DIR=/opt/htbb
# Mã nguồn website (đồng bộ dữ liệu game từ /admin/dong-bo).
HTBB_WEB_SRC_DIR=/opt/htbb/web
# Log game.out / login.out / *.log (trang /admin/chandoan).
HTBB_LOG_DIR=/opt/htbb/logs
# Ảnh tải lên từ CMS quản trị.
HTBB_UPLOAD_DIR=/opt/htbb/web/uploads
# Bản tải game (admin tải lên, nginx phát ở /downloads/) và cỡ tệp tối đa (MB).
HTBB_TAI_GAME_DIR=/opt/htbb/downloads
HTBB_TAI_GAME_TOI_DA_MB=320

# ---- Khoá ký token đăng nhập (BẮT BUỘC, >= 32 ký tự: openssl rand -hex 32) ----
# Đổi khoá = mọi người (kể cả admin) bị đăng xuất.
HTBB_SECRET=DOI_CHUOI_NGAU_NHIEN_64_KY_TU

# ---- CSDL cho server game (vps/sinh-server-ini.sh điền vào server.ini) ----
# Tài khoản MariaDB chính của game + login server.
DB_USER=htbb
DB_PASSWORD=DOI_MAT_KHAU_DB
# Tài khoản riêng cho luồng nạp (db.userNap / db.pass trong server.ini).
DB_USER_NAP=DOI_USER_DB_NAP
DB_PASS_NAP=DOI_MAT_KHAU_DB_NAP

# ---- CSDL cho website: THƯỜNG KHÔNG KHAI (web tự đọc server.ini trong HTBB_SERVER_DIR) ----
# Để dạng ghi chú! Một dòng "HTBB_DB_USER=" rỗng vẫn THẮNG server.ini (user rỗng = web không vào được CSDL).
# Bỏ dấu # khi web chạy ở máy khác / không đọc được server.ini. backup_db.sh cũng đọc HTBB_DB_HOST/PORT/USER/PASS
# khi không chạy bằng root. Giữ chữ "localhost" nếu quyền MariaDB cấp cho 'htbb'@'localhost'.
# HTBB_DB_HOST=localhost
# HTBB_DB_PORT=3306
# HTBB_DB_USER=htbb
# HTBB_DB_PASS=DOI_MAT_KHAU_DB
# HTBB_DB_GAME=htbb_db
# HTBB_DB_ACCOUNT=account
# Chỉ khi login server dùng user CSDL khác.
# HTBB_DB_ACCOUNT_USER=
# HTBB_DB_ACCOUNT_PASS=

# ---- Mạng / proxy / bảo mật header ----
# Node chạy sau nginx cùng máy: chỉ tin X-Forwarded-For từ các địa chỉ này.
HTBB_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# Địa chỉ gốc website (canonical, sitemap, OG). Trống/IP/localhost = tự chặn lập chỉ mục.
# Điền https://<tên-miền> khi tên miền đã chạy (VD https://ten-mien-cua-ban.vn).
HTBB_SITE_URL=
# CSP: enforce (mặc định) | report-only | off.  HSTS: 1 | 0 | trống = tự động.
HTBB_CSP=enforce
HTBB_HSTS=

# ---- Tải tệp cập nhật trong game (máy chủ game: server.ini sv.gocTaiCapNhat, do vps/sinh-server-ini.sh ghi) ----
# Tên miền nằm sau WAF: client không phải trình duyệt (bộ cập nhật PC, APK DownloadManager, trình duyệt J2ME) nhận
# trang thử thách JS = HTTP 403. Đặt gốc http://<IP origin> (nginx default server phục vụ /tai/, client kiểm SHA-256);
# khuyến nghị cho máy thật hiện tại (IP origin đã có sẵn trong client): HTBB_GOC_TAI_CAP_NHAT=http://180.93.57.30
# Trống = link tải theo sv.website (tên miền). Trang /download của web KHÔNG đổi (trình duyệt qua được WAF).
HTBB_GOC_TAI_CAP_NHAT=

# ---- Danh sách máy chủ cho client game (GET /server.txt) ----
# "Tên:host:cổng:loại"; nhiều máy chủ ngăn bằng hai ký tự \n trên MỘT dòng.
HTBB_SERVER_LIST=Server 1:DOI_IP_HOAC_TEN_MIEN:19129:0
# Client cũ đã phát hành tải link danh sách cũ (web/server/utils/duongDanCu.ts) — trống = cùng nội dung HTBB_SERVER_LIST.
HTBB_SERVER_LIST_CU=

# ---- Liên kết trang công khai ----
HTBB_LINK_ANDROID=#
HTBB_LINK_PC=#
HTBB_LINK_IOS=#
HTBB_LINK_JAR=#
# Dự phòng khi CMS chưa đặt Zalo; chỉ nhận https://zalo.me/..., chat.zalo.me, oa.zalo.me.
HTBB_LINK_GROUP=#
# true = đăng ký xong vào game được luôn (khi sv.EnableAvtiveCheck=1).
HTBB_AUTO_ACTIVATE=false

# ---- Quản trị (/admin) ----
# Tên TÀI KHOẢN đăng nhập (team_user.username), ngăn bằng dấu phẩy. Trống = không ai vào được.
# Cũng là danh sách được xem bản DEMO nạp tiền khi HTBB_NAP_DEMO_CHI_ADMIN=1.
HTBB_ADMIN_ACCOUNTS=ten_tai_khoan_admin
HTBB_ADMIN_2FA_BAT_BUOC=false
# IP / dải CIDR được gọi API quản trị (dấu phẩy). Trống = không giới hạn.
HTBB_ADMIN_IP_CHO_PHEP=
HTBB_ADMIN_IDLE_TIMEOUT=3600
HTBB_ADMIN_MAX_FAIL=8
HTBB_ADMIN_FAIL_WINDOW=900
# 1 = web được ghi các khoá cấu hình thử nghiệm trên máy thật (mặc định trống = không).
HTBB_CHO_PHEP_THU_NGHIEM=
# Mật khẩu v2 (scrypt) — chưa nối vào luồng đăng nhập, để trống.
HTBB_MAT_KHAU_V2=

# ---- Nạp tiền THẬT (docs/van-hanh.md mục 9) — đang TẮT ----
# Chỉ bật khi có giấy phép bằng văn bản. Bật với cấu hình yếu = web tự tắt (fail closed).
HTBB_NAP_BAT=false
# Đặt 1 SAU KHI có giấy phép hình ảnh/IP bằng văn bản.
NAP_DA_CO_GIAY_PHEP=
# Webhook SePay "API Key" (>= 24 ký tự: openssl rand -hex 24). URL: https://<tên-miền>/api/nap/webhook-sepay
HTBB_SEPAY_WEBHOOK_APIKEY=
# Token SePay user API cho job dò giao dịch lỡ webhook (trống = tắt job).
HTBB_SEPAY_API_TOKEN=
HTBB_SEPAY_API_URL=https://my.sepay.vn
HTBB_SEPAY_DO_PHUT=3
HTBB_SEPAY_DO_GIO=6
# Casso webhook v2 (HMAC) — tuỳ chọn.
HTBB_CASSO_WEBHOOK_SECRET=
# Mật khẩu trang /xac-nhan-nap (>= 12 ký tự, không phải mặc định).
HTBB_ADMIN_NAPTIEN_PASSWORD=DOI_MAT_KHAU_XAC_NHAN_NAP
# CHỈ MÁY DEV — luôn 0 trên VPS.
HTBB_NAP_SANDBOX=0
HTBB_NAP_MOCK_SECRET=

# ---- BẢN DEMO nạp tiền + Thành viên (docs/van-hanh.md mục 9.6) ----
# CẢNH BÁO: chỉ để XEM giao diện — không thu tiền, không cộng lượng / Thành viên, webhook bị từ chối.
# Số tài khoản PHẢI là số minh hoạ có chữ x; số thật = demo bị từ chối.
# Demo và nạp thật loại trừ nhau: cấu hình thật hợp lệ thì demo bị từ chối, giữ chế độ thật.
# Chuyển sang nạp thật: đặt HTBB_NAP_DEMO=0 rồi mới điền số tài khoản thật bên dưới.
HTBB_NAP_DEMO=1
# 1 = chỉ tài khoản trong HTBB_ADMIN_ACCOUNTS thấy menu/trang Nạp + Thành viên; 0 = mọi người.
HTBB_NAP_DEMO_CHI_ADMIN=1
# Tài khoản nhận tiền (khi demo: chỉ để hiển thị). Tên viết HOA không dấu.
HTBB_NAP_ACCOUNT_NO=0123456xxx
HTBB_NAP_ACCOUNT_NAME="DEMO HTBB"
# Mã BIN ngân hàng VietQR (970422 = MB Bank).
HTBB_NAP_BANK_BIN=970422

# ---- Gửi email qua Gmail API (Quên mật khẩu) — thiếu một trong 4 khoá đầu = tắt ----
# Cách lấy: node web/scripts/lay-gmail-refresh-token.mjs (docs/van-hanh.md).
# VD: HTBB_GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com, HTBB_GMAIL_SENDER=ten-gmail@gmail.com
HTBB_GMAIL_CLIENT_ID=
HTBB_GMAIL_CLIENT_SECRET=
HTBB_GMAIL_REFRESH_TOKEN=
HTBB_GMAIL_SENDER=
HTBB_MAIL_FROM_NAME="Huyền Thoại Bảo Bối"
