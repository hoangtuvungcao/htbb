# ============================================================================
#  HUYỀN THOẠI BẢO BỐI — server.ini MẪU CHO MÁY LINUX KHÔNG DÙNG BỘ SINH
#
#  TRÊN VPS ĐỪNG chép tệp này: server.ini thật được SINH từ vps/server.ini.tmpl bởi
#  vps/sinh-server-ini.sh (mật khẩu lấy từ /etc/htbb/htbb.env). Chép tệp này mà quên sửa
#  DOI_MAT_KHAU_DB thì máy chủ từ chối khởi động (TeamServer.kiemTraCSDL, sự cố 30/08/2026).
#
#  Máy Linux tự dựng (không có pipeline):
#      cp vps/server.ini.linux.example server/server.ini
#      nano server/server.ini        # sửa DOI_MAT_KHAU_DB
#      chmod 640 server/server.ini
#  Tệp này sinh lại từ server.ini.tmpl (cùng khoá, cùng giá trị trừ bí mật) — sửa bản mẫu trước.
# ============================================================================

# ==== MẠNG ====
sv.port=19129
limit.ccu=20000
sv.server=1
# Cổng nhận lệnh nạp nội bộ (nạp tiền đang TẮT, khoá vẫn phải có).
sv.portnap=19153
# Login server (CheckLoginSocket) chạy nội bộ — KHÔNG mở cổng 8023 ra internet.
sv.iplogin=127.0.0.1
sv.portlogin=8023

# ==== CƠ SỞ DỮ LIỆU (MariaDB trên cùng VPS) ====
# Phải là MariaDB hoặc MySQL 5.7: MySQL 8 bỏ PASSWORD() nên login server không xác thực được.
db.host=127.0.0.1:3306
db.name=htbb_db
db.user=htbb
db.password=DOI_MAT_KHAU_DB
# Cho phép db.password trống — chỉ máy nhà. Trên VPS LUÔN là 0 (sinh-server-ini.sh từ chối giá trị khác).
db.choPhepMatKhauTrong=0
db.maxco=100
db.nameNap=htbb_db
db.userNap=htbb
db.pass=DOI_MAT_KHAU_DB
db.maxNap=30
db.host1=127.0.0.1:3306
db.name1=htbb_db
db.user1=htbb
db.password1=DOI_MAT_KHAU_DB
db.maxco1=1
# Tham số thêm vào cuối mọi URL JDBC ("a=1&b=2"). Trống trên MariaDB.
db.thamSoJdbc=

# ==== ĐƯỜNG DẪN ====
# Phải có dấu / ở cuối, user htbb ghi được.
sv.pathLog=/opt/htbb/logs/

# ==== KHOÁ HỆ THỐNG CŨ (mã nguồn còn đọc bằng parseInt — thiếu là hỏng cả khối cấu hình) ====
# Giữ nguyên các giá trị này (cờ của mã gốc, không có giao diện): sv.lang=0 tiếng Việt,
# sv.me=0 chế độ máy chủ chính thức, api.sv mã máy chủ trong lịch bảo trì, sv.CodeTest=0 tắt mã thử.
sv.LG=3
sv.range=0
sv.lang=0
sv.me=0
api.sv=1
db.hour=-1
db.minute=2
sv.CodeTest=0
# Bảng giải đua Pokémon (bảng tob_race_*, ngày gốc tạo bảng).
sv.createRace=2
sv.tablerace=tob_race_257
sv.dayrace=2013-07-11
# Danh sách tên loại khỏi vòng quay (cách nhau dấu phẩy) / tên được miễn thu hồi đồ đua top cũ.
sv.ph=
sv.choi=

# ==== CHẾ ĐỘ GAME (đổi phải khởi động lại) ====
# Lâu dài: kinh tế dài hạn, nhiệm vụ, Chiếm Gym, đồ giữ (docs/thiet-ke-game.md).
sv.lau_dai=1
# Ngày khai trương (yyyy-MM-dd) — đặt trước khi mở cửa; trống = ngày máy chủ chạy lần đầu.
sv.ngay_khai_truong=
# Hệ sinh thái: quái/vùng đổi theo thời gian, chợ sinh thái.
sv.he_sinh_thai=1
# KHÔNG giới hạn cấp theo mùa (quyết định 18/10/2026).
sv.tran_cap_theo_mua=0
# Nạp tiền TẮT cho tới khi có giấy phép (docs/giay-phep.md). Fail-closed.
sv.nap_tien=0
# Khoá thử nghiệm (đồng hồ ảo, giá trị khoaProd) — máy thật LUÔN 0.
sv.cho_phep_thu_nghiem=0
# Bảng chỉ số máy chủ + trang_thai.json mỗi 30 giây (kiem-suc-khoe.sh, /admin) và tệp bao_tri.txt.
sv.chiSoMayChu=1
# Bảo trì hằng ngày: trống = ngẫu nhiên 4:30–5:30, "HH:MM" = cố định, "tat" = không tự bảo trì.
sv.gioBaoTri=

# ==== TÍNH NĂNG POKÉMON (bảng cau_hinh, áp dụng ngay) ====
# Tự động đánh chính thức (thay mọi mod auto cũ), giới hạn giờ/ngày.
tu_dong.bat=1
tu_dong.gio_moi_ngay=5
tu_dong.chi_map_da_mo=1
tu_dong.tat_khi_pvp=1
# Bộ não máy chủ (client 0.9.2+): chọn mục tiêu gần nhất theo đường đi, chiêu theo khắc hệ / PP, thuốc theo ngưỡng,
# nhặt đồ, rút lui khi HP thấp; dừng khi đầy túi / tự di chuyển. Mọi khoá tu_dong.*: docs/cau-hinh.md.
tu_dong.ke_hoach=1
tu_dong.chenh_cap_tren=5
tu_dong.danh_boss=0
tu_dong.dung_khi_day_tui=1
tu_dong.dung_khi_tu_di=1
# Không bao giờ tự dùng vật phẩm hồi sinh mua bằng lượng, trừ khi bật ở đây VÀ người chơi đồng ý riêng trong bảng.
tu_dong.hoi_sinh_tra_phi=0
# Hồi sinh mất phí (xu theo giờ chơi, khoá ở PvP / Gym / boss / mê cung).
hoi_sinh.bat=1
# Trần chỉ số trang bị.
chi_so.bat=1
chi_so.kep_trang_bi=1
# Chiếm Gym, hầm ngục, điểm PvP.
gym.bat=1
ham_nguc.bat=1
pvp.tinh_diem.bat=1
# Thành viên trả phí: TẮT (bật sau khi có nạp tiền).
thanh_vien.bat=0
thanh_vien.ban_bat=0
# Kích hoạt tài khoản: chưa kích hoạt vẫn đăng nhập và chơi, chỉ khoá vài tính năng.
kich_hoat.chan_dang_nhap=0
kich_hoat.chuc_nang=giao_dich,chat_the_gioi,cho,chuyen_luong,nhan_tang,giftcode
# Bảo trì đăng nhập thủ công (bật từ /admin khi cần).
bao_tri.bat=0

# ==== TÀI KHOẢN + ĐĂNG KÝ ====
# 1 = bật cơ chế kích hoạt tài khoản (cổng kich_hoat.* ở trên); 0 = coi mọi tài khoản đã kích hoạt.
sv.EnableAvtiveCheck=1
# Đăng ký ngay trong game (jar / Android / PC); quy tắc + hạn mức chung với web.
sv.dangKyTrongGame=1
# Tự kích hoạt sau khi đăng ký trong game: web = theo cấu hình web, 1 = luôn, 0 = không.
sv.dangKyTuKichHoat=web
sv.dangKyCsdlTaiKhoan=account
# Độ trễ trả lời đăng ký (ms) chống bot.
sv.dangKyTreMs=800
# Số Pokémon (nhân vật) tối đa mỗi tài khoản, 1..3.
sv.maxCharPerAccount=3

# ==== TỈ LỆ RƠI / EXP (GIÁ TRỊ KHỞI TẠO LẦN ĐẦU — sau đó sửa ở /admin) ====
# Phần trăm so với gốc: 100 = như gốc, 0 = tắt.
sv.tileXu=4
sv.tileLuong=10
sv.tileItemSuKien=10
sv.tilePotion=14
sv.tileNgoc=14
sv.tileItem=10
# Số chia số lượng xu mỗi lần rơi (10 = gốc).
sv.chiaXuRoi=30
sv.tileExpLv50=10
sv.tileExpDuoiLv50=50
# Thưởng EXP: giao hàng (x2), may mắn, quà — 1 = bật.
sv.expvantieu=1
sv.Luckyexp=1
sv.ExpQua=1

# ==== GIAO HÀNG (tên khoá cũ "tieu" — vẫn được mã nguồn đọc) ====
# 5 ngưỡng CỘNG DỒN (Trắng/Xanh/Đỏ/Hoàn Mỹ/Vàng) trên 100000, tăng dần; còn lại là Tím.
sv.tieuNguongMau=60189,89389,99689,99989,99999
# % EXP nhân trước khi áp tỉ lệ theo màu (200 = x2).
sv.tieuHeSoExp=200
sv.tieuPcExpTheoMau=50,100,150,250,250,500,0
sv.tieuPermilleCaoCap=50,70,90,35,55,75,5,25,45
# Ngưỡng màu khi ĐỔI hàng (trả xu / lượng).
sv.doiTieuNguongMauXu=50545,85545,98945,99945,99995
sv.doiTieuNguongMauLuong=22890,52890,96890,99890,99990

# ==== QUẢN TRỊ ====
sv.website=https://huyenthoaibaoboi.fun/
sv.linkTaiGame=https://huyenthoaibaoboi.fun/
# Chế độ thử: máy thật LUÔN 0, mã thử trống.
sv.testMode=0
sv.testCode=
# Tài khoản GM (tên Pokémon, cách nhau dấu phẩy).
sv.adminAccounts=admin
# Cho tạo tên chứa "admin" (chỉ bật tạm khi tạo GM, xong đặt lại 0).
sv.choPhepTaoTenGM=0
# 1 = quyền GM cần thêm pInfo[16]=1 trong tob_char (bật sau khi đã đặt cho GM thật).
sv.gmCanCoPInfo=0
# Cập nhật client (0.9.7, nên đặt trên web /admin/cau-hinh-he-thong): bản tối thiểu - client gửi số bản < N bị chặn
# đăng nhập, hiện hộp "Cần cập nhật" + nút Tải bản mới (0 = tắt). Số bản = BAN= trong tools/phat-hanh/phien_ban.conf.
sv.banToiThieu=0
# Bản mới nhất dự phòng (khi bản tải ở /admin/tai-game chưa ghi Số bản). 0 = chỉ theo trang Bản tải game.
sv.banMoiNhat=0
# 0 = tắt thẻ "Đã có bản mới" (khẩn cấp).
sv.nhacCapNhat=1
# Chờ (giây) trước khi vào lại game sau khi thoát (theo nhân vật). 0 = vào lại ngay.
sv.reloginWaitSec=0
# Bật log chẩn đoán hình thú cưỡi cho đúng MỘT tên Pokémon; trống = tắt.
sv.thuNghiemThuCuoi=

# ==== CHỐNG DoS (giới hạn theo IP) ====
# Ngắt kết nối im lặng quá 180 giây; tối đa 60 kết nối mới / 30 giây / IP, quá thì chặn 300 giây.
sv.socketTimeout=180
sv.maxConnPerIp=50
sv.connRateMax=60
sv.connRateWindow=30
sv.dosBanSec=300
# Proxy tin cậy (IP/CIDR, IPv4/IPv6): miễn mọi giới hạn theo IP. Mặc định chỉ loopback (Nova agent
# cùng máy). CHỈ thêm IP proxy nếu IP thật của người chơi không tới được máy chủ — thêm ở /admin
# (áp dụng ngay), không ghi IP WAF vào Git.
sv.proxyTinCay=127.0.0.1,::1
# Đăng nhập dồn dập từ MỘT IP thường: >= ngưỡng lần/giây thì chờ + ghi nghi vấn. 0 = tắt.
sv.dangNhapIpNguong=10
sv.dangNhapIpChoMs=3000

# ==== NGẬP GÓI TIN (mỗi kết nối, cửa sổ 5 giây) ====
# Lệnh thường / tải tài nguyên (-47/-48/-49/-51) / tra cứu (7) đếm riêng. KHÔNG hạ, KHÔNG đặt 0 trên VPS.
sv.tranGoiThuong=300
sv.tranGoiTaiNguyen=600
sv.tranGoiTraCuu=600
# Nén gói lớn (>= sv.nenGoiTu byte, zlib) — CHỈ cho client tự báo giải nén được (0.9.7+ PC/Android); client cũ không đổi gì.
sv.nenGoi=1
sv.nenGoiTu=2048
# Chia gói lớn (>= sv.manhGoiTu byte) thành mảnh sv.coManhGoi byte — CHỈ cho client J2ME tự báo gom được (0.9.7.1+); jar 0.9.7 không đổi gì.
sv.manhGoi=1
sv.manhGoiTu=16384
sv.coManhGoi=8192
# IP không bị đếm ngập gói — CHỈ cho máy chạy bot tải. VPS để trống (dòng chú thích).
#sv.tranGoiMienIp=

# ==== NHẬT KÝ + CHỐNG SPAM (mặc định trong mã nguồn; bỏ dấu # để đổi) ====
# Nhật ký: tệp ở <sv.pathLog>/nhat_ky/ (may_chu-*.log, kiem_toan-*.log).
#sv.log.muc=THONG_TIN
#sv.log.mucTep=THONG_TIN
#sv.log.tat=GOI3,GOI5,GOI26,VKTT,SQL,LUU_CHAR
#sv.log.kiemToan=ADMIN,GM,NAP,NAP_TIEN,GIFTCODE,CAM,BAN,KINH_TE,KINHTE,CHONG_SPAM
#sv.log.lapToiDa=5
#sv.log.loaiToiDa=120
#sv.log.cuaSoGiay=60
#sv.log.cuaSoStackGiay=600
#sv.log.hangDoi=50000
#sv.log.tep=1
#sv.log.thuMuc=
#sv.log.tepToiDaMB=100
#sv.log.soTepMoiNgay=5
#sv.log.giuNgay=14
#sv.log.giuNgayKiemToan=90
#
# Chống spam chat: nhịp "số/giây", admin miễn.
#sv.spam.bat=1
#sv.spam.chat.gan=5/10
#sv.spam.chat.rieng=6/10
#sv.spam.chat.theGioi=1/30
#sv.spam.theGioiToanServer=12/60
#sv.spam.chat.doi=8/10
#sv.spam.chat.bang=8/10
#sv.spam.trungLapGiay=30
#sv.spam.chanQuangCao=1
#sv.spam.quangCaoThem=
#sv.spam.viPhamCam=4
#sv.spam.viPhamQuenGiay=600
#sv.spam.camGiay=60,300,1800,7200
#sv.spam.bacQuenGio=24
#sv.spam.baoCachGiay=5
#
# Chống spam thao tác (vượt nhịp = bỏ thao tác, không cắt kết nối).
#sv.spam.hd.moiDoi=4/10
#sv.spam.hd.moiBang=4/10
#sv.spam.hd.ketBan=4/10
#sv.spam.hd.moiGiaoDich=4/10
#sv.spam.hd.npc=25/5
#sv.spam.hd.raoBan=6/30
#sv.spam.hd.muaBan=25/5
#sv.spam.hd.dangKy=5/60
#
# Thông báo toàn máy chủ: giới hạn + gộp.
#sv.thongBao.bat=1
#sv.thongBao.toiDa=6
#sv.thongBao.cuaSoGiay=60
#sv.thongBao.moiLoai=3
#sv.thongBao.trungLapGiay=120
#sv.thongBao.gopGiay=15

# ==== SỰ KIỆN ====
# Bật/tắt sự kiện ở /admin/sukien (bảng tob_su_kien). Năm dòng dưới chỉ là giá trị khi bảng chưa
# có dòng tương ứng (máy chủ chạy lần đầu): sự kiện mùa cũ (Trung thu, Tết, Giỗ Tổ, Noel, Tết
# dương lịch) đều TẮT.
sv.isSuKienTrungThul2016=0
sv.isSuKienTet2017=0
sv.isSuKienGioTo2016=0
sv.isSuKienNoel2023=0
sv.isSuKienTetduonglich2024=0
# Đổi sự kiện cần khởi động lại: máy chủ tự gom thay đổi rồi khởi động lại (báo trước 60 giây).
# Đừng hạ sv.suKienGomGiay quá thấp: htbb-game.service chỉ cho 5 lần khởi động / 300 giây.
sv.suKienTuKhoiDongLai=1
sv.suKienGomGiay=120
sv.suKienBaoTruocGiay=60
# Sự kiện bình chọn bóng đá (giá trị khi bảng chưa có dòng; trống = TẮT). "yyyy-MM-dd HH:mm:ss".
sv.worldCupBatDau=
sv.worldCupKetThuc=
sv.worldCupHanNhanQua=
# Giá xu đổi bó hoa sự kiện Vu Lan (NPC Đấu trường).
sv.giaXuBoHoaDoVuLan=150000

# ==== GIỜ CHIẾM GYM ====
# -1 = lịch chuẩn 21h thứ 3 + thứ 7. sv.ngayChiemThanh: trống = mỗi ngày, "2026-07-28" hoặc "Tue"/"Sat".
# Lệnh chat "stown" đổi ngay trong game, nhưng deploy sau đặt lại theo đây (muốn giữ: @GIU_NGUYEN@).
sv.gioChiemThanh=-1
sv.phutChiemThanh=-1
sv.ngayChiemThanh=
