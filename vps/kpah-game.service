[Unit]
Description=HTBB game server
After=network.target mariadb.service kpah-login.service
Wants=mariadb.service kpah-login.service

# Thoi khoi dong lai sau 5 lan chet trong 300s, de unit vao trang thai "failed"
# thay vi lap vo han. Can cho chot kiemTraCSDL() trong TeamServer: khi server.ini
# sai mat khau CSDL, server tu thoat ma 1 - khong co gioi han nay thi Restart=always
# se khoi dong lai mai mai moi 10s va khong ai thay unit hong.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kpah
Group=kpah
WorkingDirectory=/opt/kpah
Environment=LANG=en_US.UTF-8

# QUAN TRONG - server nay tao MOT THREAD cho MOI REGION cua MOI MAP
# (Region.<init> -> startSandVilage), tong len tren 2000 thread.
#   TasksMax: mac dinh cua systemd tren Ubuntu chi ~2250 -> chet voi
#             "OutOfMemoryError: unable to create new native thread".
#   -Xss256k: mac dinh moi thread chiem 1 MB stack -> 2000 thread = 2 GB,
#             vuot RAM. Ha xuong 256k -> ~500 MB.
TasksMax=infinity
LimitNPROC=infinity
LimitNOFILE=65535

# -Xmx theo RAM cua VPS (nho tru phan stack thread o tren):
#     VPS 1 GB -> -Xmx384m
#     VPS 2 GB -> -Xmx768m   (mac dinh o day)
#     VPS 4 GB -> -Xmx2g
# Dung dat -Xmx sat RAM: JVM con ton metaspace + stack thread + bo dem GC.
# -Djava.awt.headless=true: VPS khong co man hinh (AdminPanel tu bo qua).
ExecStart=/usr/bin/java -Xms256m -Xmx768m -Xss256k -Djava.awt.headless=true -Dfile.encoding=UTF-8 -jar KPAH2_patched.jar

# Tat = SIGTERM -> shutdown hook trong TeamServer luu char/clan/market roi moi thoat.
# TimeoutStopSec phai du dai cho no luu xong, dung ha xuong duoi 60s.
KillSignal=SIGTERM
TimeoutStopSec=180
Restart=always
RestartSec=10

StandardOutput=append:/opt/kpah/log/game.out
StandardError=append:/opt/kpah/log/game.out

[Install]
WantedBy=multi-user.target
