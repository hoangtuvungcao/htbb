# /etc/systemd/system/htbb-game.service - HTBB game server (TCP 19129).
# Cai: install -m 644 vps/htbb-game.service /etc/systemd/system/ && systemctl daemon-reload
[Unit]
Description=HTBB game server (TCP 19129)
After=network-online.target mariadb.service htbb-login.service
Wants=network-online.target htbb-login.service
Requires=mariadb.service

# Thoi khoi dong lai sau 5 lan chet trong 300s, de unit vao trang thai "failed"
# thay vi lap vo han. Can cho chot kiemTraCSDL() trong TeamServer: khi server.ini
# sai mat khau CSDL, server tu thoat ma 1 - khong co gioi han nay thi Restart=always
# se khoi dong lai mai mai moi 10s va khong ai thay unit hong.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=htbb
Group=htbb
# /opt/htbb = ban checkout monorepo; server.ini (sinh boi vps/sinh-server-ini.sh) nam canh jar.
WorkingDirectory=/opt/htbb/server
Environment=LANG=en_US.UTF-8
# Chung tep env voi web (thong tin CSDL...). Game tu doc server.ini; dau "-" = thieu tep van chay.
EnvironmentFile=-/etc/htbb/htbb.env
UMask=0027

# THREAD (docs/kien-truc.md): pool chung com.htbb.runtime.VongLapChung, ~170 thread
# khi rong + 2 thread / ket noi. TasksMax/LimitNPROC giu infinity cho an toan (lop trong
# lib/htbb-core.jar - MapBoss, ArenaMap, su kien - van tao thread rieng khi mo).
TasksMax=infinity
LimitNPROC=infinity
LimitNOFILE=65535

# BO NHO - VPS 4 GB: heap 1.5 GB + metaspace/stack/GC ~300 MB. MariaDB (buffer pool 768M) ~1 GB,
# web ~400 MB. MemoryHigh/MemoryMax chan JVM an het RAM cua MariaDB.
MemoryHigh=2100M
MemoryMax=2400M

# -XX:+UseG1GC: ghi ro - tren VPS 1-2 vCPU JVM tu chon SerialGC (dung ca server moi lan GC).
# -XX:+ExitOnOutOfMemoryError: het bo nho thi THOAT de Restart=always dung lai server sach.
#   Khong ghi heap dump: o dia VPS nho, mot ban dump ~1.5 GB co the lam day dia.
# -Xlog:gc...: CAN JAVA >= 11 (VPS cai openjdk-17-jre-headless).
# -Djava.awt.headless=true: VPS khong co man hinh (AdminPanel tu bo qua).
ExecStart=/usr/bin/java -Xms768m -Xmx1536m -Xss256k \
  -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+UseStringDeduplication \
  -XX:+ExitOnOutOfMemoryError \
  -Xlog:gc:file=/opt/htbb/logs/gc.log:time:filecount=5,filesize=10m \
  -Djava.awt.headless=true -Dfile.encoding=UTF-8 \
  -jar htbb-server.jar

# Tat = SIGTERM -> shutdown hook trong TeamServer luu char/clan/market roi moi thoat.
# TimeoutStopSec phai du dai cho no luu xong, dung ha xuong duoi 60s.
KillSignal=SIGTERM
TimeoutStopSec=180
Restart=always
RestartSec=10
# systemd mo tep append: bang quyen ROOT nen tep moi tao thuoc root:root 0640 -> web (User=htbb) khong doc duoc
# (/admin/chandoan, /admin/log bao 'khong doc duoc'). '+' = chay bang root; idempotent.
ExecStartPre=+/bin/sh -c 'touch /opt/htbb/logs/game.out && chown htbb:htbb /opt/htbb/logs/game.out && chmod 0640 /opt/htbb/logs/game.out'
StandardOutput=append:/opt/htbb/logs/game.out
StandardError=append:/opt/htbb/logs/game.out

[Install]
WantedBy=multi-user.target
