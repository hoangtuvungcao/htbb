#Tien Len TeaM Server  —  BAN MAU SINH TU PIPELINE
#
# ============================================================================
#  DAY LA NGUON DUY NHAT CUA CAU HINH SERVER.
#
#  Sua file nay tren GitHub roi commit -> deploy tu dong sinh lai
#  /opt/kpah/server.ini tren VPS va khoi dong lai server neu cau hinh doi.
#  KHONG sua tay /opt/kpah/server.ini nua: lan deploy sau se ghi de.
#
#  Hai loai gia tri dac biet:
#    ${TEN_BIEN}    lay tu GitHub Secrets (mat khau - khong bao gio nam trong git).
#                   Neu chua dat secret thi giu nguyen gia tri dang chay tren VPS,
#                   nen them file nay vao khong lam sap server.
#    @GIU_NGUYEN@   khong dung toi, giu nguyen gia tri dang chay tren VPS. Dung cho
#                   cac khoa ma trong game sua duoc (vd gio chiem thanh bang lenh
#                   stown) - de deploy khong nuot mat thay doi vua dat trong game.
#
#  Khoa nao co gia tri thang o day thi GITHUB THANG: sua trong game bang bang
#  "setting" van an ngay, nhung lan deploy ke tiep se dat lai theo file nay.
#  Muon trong game thang han thi doi gia tri thanh @GIU_NGUYEN@.
# ============================================================================

sv.port=19129
limit.ccu=20000

# ==== DATABASE (MariaDB tren cung VPS) ====
# CHU Y: phai la MariaDB hoac MySQL 5.7. MySQL 8 da bo ham PASSWORD() ->
# login server (CheckLoginSocket.jar) khong xac thuc duoc mat khau.
db.host=localhost:3306
db.name=kpah_db
db.user=${DB_USER}
db.password=${DB_PASSWORD}
# Cho phep db.password de trong. TREN VPS PHAI LUON LA 0.
# Chi may nha (XAMPP, root khong mat khau) moi dat 1, va dat trong server.ini cua may do
# chu KHONG phai o day. De 1 o ban mau nay la go mat mot lop chan cua su co 30/08/2026.
# vps/sinh-server-ini.sh tu choi cai neu gia tri khac 0. Xem TeamServer.choPhepMatKhauTrong().
db.choPhepMatKhauTrong=0
db.maxco=100
db.nameNap=kpah_db
db.userNap=${DB_USER_NAP}
db.pass=${DB_PASS_NAP}
db.maxNap=30
#
db.host1=localhost:3306
db.name1=kpah_db
db.user1=${DB_USER1}
db.password1=${DB_PASSWORD1}
db.maxco1=1
#
sv.portnap=19153
sv.server=1
sv.LG=3
sv.range=0

# ==== DUONG DAN LINUX ====
# PHAI co dau / o cuoi. Thu muc phai ton tai va user kpah ghi duoc.
sv.pathLog=/opt/kpah/log/
db.run=/opt/kpah/vps/update.sh

sv.createRace=2
sv.tablerace=tob_race_257
sv.dayrace=2013-07-11
db.hour=-1
db.minute=2
sv.lang=0
sv.me=0
sv.ph=
sv.choi=snduca

# Login server chay noi bo tren cung VPS - KHONG mo cong 8023 ra internet
sv.iplogin=127.0.0.1
sv.portlogin=8023

api.sv=1
api.url=https://domain.com
sv.expvantieu=1
sv.Luckyexp=1
sv.ExpQua=1
sv.CodeTest=0
sv.EnableAvtiveCheck=1
# So nhan vat toi da moi tai khoan (1..3, client chi ve duoc 3 slot).
sv.maxCharPerAccount=3

# ==== TI LE DROP KHI TRAIN QUAI ====
# Cac so la PHAN TRAM so voi ti le goc: 100 = nhu ban goc, 10 = con 1/10, 0 = tat han.
# Tu 09/09/2026: CHI la gia tri KHOI TAO LAN DAU, chep 1 lan vao bang SQL cau_hinh
# luc server khoi dong (INSERT IGNORE, khong ghi de). Sau do sua o day KHONG con
# tac dung nua - sua qua trang /admin/cauhinh.php hoac bang "setting" trong game.
# Xem docs/cau-hinh-server-ini.md muc 3-4, src/server/CauHinh.java.
sv.tileXu=4
sv.tileLuong=10
sv.tileItemSuKien=10
sv.tilePotion=14
sv.tileNgoc=14
sv.tileItem=10
# So chia SO LUONG xu moi lan rot. 10 = nhu ban goc, 30 = chi con 1/3.
sv.chiaXuRoi=30

# Su kien Vu Lan (NPC Dau Truong, npcType -31): gia xu doi "50 hoa hong vang -> 1 bo hoa
# do". Moi server tu dat rieng - Van Xuan dat thap hon cac server khac. Mac dinh 150000
# neu khong co dong nay.
sv.giaXuBoHoaDoVuLan=150000

# Trang chu + link tai game gui xuong client sau khi dang nhap.
sv.website=http://180.93.57.30/
sv.linkTaiGame=http://180.93.57.30/

# ==== TEST FLAGS ====
sv.testMode=0
sv.testCode=
# sv.adminAccounts so sanh voi TEN NHAN VAT (charname), khong phai ten tai khoan.
sv.adminAccounts=admin,admin2,chienthan
# Moi ten CO CHUA chu "admin" deu bi chan khi tao nhan vat (chong mao danh GM).
# Muon tao nhan vat ten "admin": dat =1, trong game go "setting" roi lenh 8, tao
# nhan vat, roi dat lai =0. Nho commit lai =0, khong thi deploy sau van mo.
sv.choPhepTaoTenGM=0
sv.reloginWaitSec=0

# ==== CHONG DoS ====
# socketTimeout=0 va connRateWindow=0 nghia la TAT han hai lop bao ve do.
# Mac dinh trong ma nguon neu thieu dong: socketTimeout=180, connRateWindow=30.
sv.socketTimeout=0
sv.maxConnPerIp=50
sv.connRateMax=60
sv.connRateWindow=0
sv.dosBanSec=300

# Nguong NGAP GOI TIN moi 5 giay cho MOT ket noi (io/BoDemGoiTin): lenh thuong va lenh tai
# nguyen (-47/-48/-49/-51, tuc tai anh) dem rieng. Hai so nay la dung gia tri da chay tu
# truoc, DUNG ha xuong va DUNG dat 0 o day.
# 0 = TAT han phep dem do (giong quy uoc sv.socketTimeout / sv.connRateWindow). Chi may nha
# moi nen tat: qua loopback khong co do tre mang nen client cache rong cham tran mot cach
# luong thien, va tat o VPS la mo cua cho spam lenh -51 (doc anh tu dia).
sv.tranGoiThuong=300
sv.tranGoiTaiNguyen=600

# ==== SU KIEN ====
# Tu 30/08/2026 cho bat/tat su kien la TRANG QUAN TRI /admin/sukien.php (bang
# tob_su_kien trong CSDL), khong phai file nay. Moi su kien deu bat duoc, khong con
# moc ngay ghi cung nao trong ma nguon nua - xem src/real/SuKien.java.
#
# Nam dong duoi day chi con la GIA TRI MAC DINH: chung quyet dinh trang thai cua nam
# su kien do khi bang tob_su_kien chua co dong tuong ung (may chu chay lan dau sau khi
# cap nhat). Sau lan khoi dong dau tien, bang CSDL la nguon duy nhat va sua o day
# khong con tac dung.
#
# sv.isSuKien83 DA BO khoi ban mau: no khong duoc doc o dau trong ma nguon, de lai chi
# lam nguoi ta tuong chinh duoc cai gi do. Xem docs/cau-hinh-server-ini.md muc 10.
sv.isSuKienTrungThul2016=1
sv.isSuKienTet2017=0
sv.isSuKienGioTo2016=0
sv.isSuKienNoel2023=0
sv.isSuKienTetduonglich2024=0

# ==== LICH HEN SU KIEN + TU KHOI DONG LAI ====
# Doi mot su kien chi co hieu luc sau khi khoi dong lai may chu (bang shop, Map.isSale,
# danh sach NPC deu duoc dung MOT LAN luc bat may theo trang thai su kien). Mac dinh may
# chu tu lo viec do; xem src/real/LichSuKien.java.
#
# sv.suKienTuKhoiDongLai : 1 = tu khoi dong lai khi thiet lap doi (mac dinh), 0 = tat han
#                          - luc do lich hen VAN chay, chi la nguoi van hanh phai tu
#                          chay `systemctl restart kpah-game`.
# sv.suKienGomGiay       : doi bao lau khong con thay doi nao nua moi khoi dong lai.
#                          Kep trong 30..3600. DUNG HA XUONG THAP: kpah-game.service dat
#                          StartLimitBurst=5 / 300s, bat vai su kien lien tay ma moi lan
#                          mot lan khoi dong lai la unit vao trang thai "failed" va server
#                          NAM HAN cho toi khi co nguoi ssh vao.
# sv.suKienBaoTruocGiay  : bao trong game bao lau truoc khi tat. Kep trong 10..600.
#                          Duoi 10 giay thi tin bao khong kip troi het hang doi cua client
#                          (moi tin mat 15-20 giay) - nguoi choi bi da ma khong thay chu nao.
sv.suKienTuKhoiDongLai=1
sv.suKienGomGiay=120
sv.suKienBaoTruocGiay=60

# ==== GIO CHIEM THANH ====
#   -1 = lich chuan 21h thu 3 + thu 7.
#   sv.ngayChiemThanh: trong = moi ngay; "2026-07-28" = dung ngay; "Tue"/"Sat" = thu.
#
# Lenh chat "stown" trong game van dat duoc ngay lap tuc, nhung lan deploy ke tiep se
# dat lai theo ba dong duoi day. Muon trong game thang han thi doi gia tri thanh
# @GIU_NGUYEN@ - luc do bo sinh khong dung toi, giu nguyen cai dang chay tren VPS.
sv.gioChiemThanh=-1
sv.phutChiemThanh=-1
sv.ngayChiemThanh=

# Bat log chan doan thu cuoi cho DUNG MOT nhan vat (so theo ten, khong phan biet
# hoa/thuong). De trong = tat. Dung khi soi loi hinh thu cuoi / skin linh thu ma
# khong muon ngap log ca server.
sv.thuNghiemThuCuoi=

# ==== LENH CHAT ADMIN ====
# setting : bang setting. Trong o nhap: 8 = nap lai server.ini (17 khoa, xem
#           docs/cau-hinh-server-ini.md muc 4).
# stown 1 <gio> <phut> [2026-07-28] : set gio chiem thanh
# stown 0 hoac ktct : tra ve lich chuan
# tgct : xem gio chiem thanh dang dat

# ==== SU KIEN WORLD CUP (binh chon Messi / Ronaldo) ====
# CACH BAT CHINH THUC gio la trang quan tri /admin/sukien.php (hai dong "World Cup").
# Ba dong duoi day chi con la GIA TRI MAC DINH cho hai cong do khi bang tob_su_kien
# chua co dong tuong ung. Dinh dang "yyyy-MM-dd HH:mm:ss", thu tu batDau < ketThuc <=
# hanNhanQua; de trong bat ky dong nao = mac dinh TAT.
#   batDau..ketThuc      : dang binh chon - quai roi bong vang, doi phieu duoc
#   ketThuc..hanNhanQua  : het binh chon, ben thang vao NPC nhan qua
sv.worldCupBatDau=
sv.worldCupKetThuc=
sv.worldCupHanNhanQua=
