# ==== DANG KY TAI KHOAN TRONG GAME (lenh 39, real.cmd.DangKyTrongGame) ====
# 1 = cho dang ky ngay trong game (jar/Android/PC), 0 = chi tren web.
# Quy tac + han muc (3/gio, 10/ngay moi IP, gop voi web) o HTBB-Web/shared/data/quy-tac-dang-ky.json.
sv.dangKyTrongGame=1
# Kich hoat 5h_active 30 ngay sau khi dang ky trong game:
#   web = theo HTBB_AUTO_ACTIVATE cua web (web tu ghi cau_hinh 'web.autoActivate'), 1 = luon, 0 = khong.
sv.dangKyTuKichHoat=web
# CSDL chua bang team_user (giong HTBB_DB_ACCOUNT cua web) va do tre tra loi chong bot (ms).
sv.dangKyCsdlTaiKhoan=account
sv.dangKyTreMs=800
# So nhan vat toi da moi tai khoan (1..3, client chi ve duoc 3 slot).
sv.maxCharPerAccount=3

# ==== TI LE DROP KHI TRAIN QUAI ====
# Cac so la PHAN TRAM so voi ti le goc: 100 = nhu ban goc, 10 = con 1/10, 0 = tat han.
# Tu 09/09/2026: CHI la gia tri KHOI TAO LAN DAU, chep 1 lan vao bang SQL cau_hinh
# luc server khoi dong (INSERT IGNORE, khong ghi de). Sau do sua o day KHONG con
# tac dung nua - sua qua trang /admin/cauhinh hoac bang "setting" trong game.
# Xem docs/cau-hinh-server-ini.md muc 3-4, src/server/CauHinh.java.
sv.tileXu=4
sv.tileLuong=10
sv.tileItemSuKien=10
sv.tilePotion=14
sv.tileNgoc=14
sv.tileItem=10
# So chia SO LUONG xu moi lan rot. 10 = nhu ban goc, 30 = chi con 1/3.
sv.chiaXuRoi=30

# ==== TI LE EXP QUAI THUONG (khong dung Boss) ====
# Cung la GIA TRI KHOI TAO LAN DAU nhu khoi tren, sau do sua qua
# /admin/cauhinh hoac bang "setting". 100 = nhu ban goc.
# Xem Monster.rcvXpSauGiam(), src/server/CauHinh.java.
sv.tileExpLv50=10
sv.tileExpDuoiLv50=50

# ==== TI LE MAU + HE SO EXP VAN TIEU ====
# Cung la GIA TRI KHOI TAO LAN DAU, sua qua /admin/cauhinh sau do.
# sv.tieuNguongMau: 5 nguong CONG DON (Trang/Xanh/Do/Hoan My/Vang) tren thang
#   100000, PHAI tang dan; phan con lai la Tim. Xem Char.TIEU_NGUONG_MAU,
#   Char.doInitMonter().
# sv.tieuHeSoExp: % nhan truoc khi ap ti le theo mau, 200 = x2 (gia tri cu).
# sv.tieuPcExpTheoMau: 7 % EXP theo mau (Trang/Xanh/Do/HoanMy/Vang/Tim/_),
#   dung khi lvOpen<50 hoac mau Trang/Xanh/Do. Xem CharSuKien.doResponseTieu().
# sv.tieuPermilleCaoCap: 9 phan nghin EXP can len cap, rieng Hoan My/Vang/Tim
#   tu lv50, gop 3 khung cap (50-59/60-69/70+) x 3 mau.
# sv.doiTieuNguongMauXu / sv.doiTieuNguongMauLuong: 5 nguong CONG DON rieng cho
#   DOI tieu (reroll tra phi), doc lap voi sv.tieuNguongMau. Xem Char.doChangeTieu().
sv.tieuNguongMau=60189,89389,99689,99989,99999
sv.tieuHeSoExp=200
sv.tieuPcExpTheoMau=50,100,150,250,250,500,0
sv.tieuPermilleCaoCap=50,70,90,35,55,75,5,25,45
sv.doiTieuNguongMauXu=50545,85545,98945,99945,99995
sv.doiTieuNguongMauLuong=22890,52890,96890,99890,99990

