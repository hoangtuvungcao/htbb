# ==== CHE DO POKEMON (nhanh pokemon/chuyen-doi) ====
# 1 = bat: he 18 loai thay ngu hanh trong sat thuong, tien hoa theo cap, quai lay he tu
#     data_monster (khong random), gui lenh -90/-91/-92 cho ClientUnity. Can chay
#     sql/them_cot_pokemon.sql (server cung tu them cot neu thieu) va
#     sql/pokemon_du_lieu_quai.sql truoc.
# 0 = game goc, y nhu truoc. Thieu dong = 0. Doi gia tri phai khoi dong lai server.
# Xem docs/cau-hinh-server-ini.md muc 7b, docs/pokemon/KE_HOACH_CHUYEN_DOI.md (Q8).
sv.che_do_pokemon=1

# ==== THIET KE DAI HAN (giai doan 2) ====
# 1 = bat: kinh te moi (bo luong roi tu quai, xu roi theo cap, nang luong huan luyen, gia nang
#     cap theo bac + pity, thue cho 6%+1%, phi theo thu nhap), bang EXP moi (len cap cham, nang luong
#     90 phut/ngay, vat pham tang toc) + tinh thong, nhiem vu loc theo cap + ve chuong tuan, cong thuc sat thuong moi, boss theo
#     pha, goi -95..-99. Can chay sql/pokemon_lau_dai.sql + sql/them_bang_lau_dai.sql truoc.
# 0 = y nhu truoc. Thieu dong = 0. Doi gia tri phai khoi dong lai server.
# Xem docs/cau-hinh-server-ini.md muc 7c, docs/pokemon/KE_HOACH_LAU_DAI_GD2.md.
sv.lau_dai=0
# Bat/tat TU DONG: khoi dong lai la server tu chuyen EXP nhan vat sang bang dung voi co (ca chieu tat).
# Ngay khai truong (yyyy-MM-dd, khong bat buoc): ngay 0 cua lich su kien / mua PvP / ve mua (va cua tran cap
# theo mua neu bat). De trong = lan bat dau tien tu ghi hom nay vao cau_hinh lau_dai.ngay_khai_truong va dung lai.
sv.ngay_khai_truong=
# Tran cap theo mua 60 -> 70 -> 80 -> 91 -> 95 -> 100 (thiet ke cu). 0 / thieu dong = TAT (18/10/2026: khong tran,
# noi dung mo theo cap + cot truyen, docs/pokemon/THIET_KE_LAU_DAI.md muc 1.4). 1 = bat lai. Khoi dong lai.
sv.tran_cap_theo_mua=0

# Gio bao tri tu dong hang ngay: HH:MM (vd 04:45), "tat" = khong tu tat may, de trong = ngau nhien
# 4:30-5:30 nhu cu. Server tu thoat luc bao tri; vps/htbb-game.service (Restart=always) bat lai.
sv.gioBaoTri=

